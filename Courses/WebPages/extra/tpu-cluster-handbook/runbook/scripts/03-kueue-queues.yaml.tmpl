# =============================================================================
# 03-kueue-queues.yaml.tmpl —— §3.5 ClusterQueue + LocalQueue（单队列形态）
# 模板变量：${TPU_QUOTA} ${NS} ${LOCAL_QUEUE}（envsubst '${TPU_QUOTA} ${NS} ${LOCAL_QUEUE}'，由 03-addons.sh queues 渲染）
#
# 出处：实测集群线上 cluster-queue / multislice-queue 字段原样，
#   只把 flavor / AC 名换成本书的 tpu7x-flavor-v2 / dynamic-slicing-ac，并按参考集群给 AC 加上 onFlavors。
#   onFlavors 在只有一个 flavor 时可省（实测集群就没写），写上是为了以后加 flavor 时不会「准入了但永远不切片」。
# 多队列形态（cohort + 两个 CQ）见手册 §3.5 的摘要。
#
# ${TPU_QUOTA} = min(CUBES_MAX_JOB=128, 当前健康 cube − 备件 S) × 64，按芯片数；健康只算 HEALTHY 且排除已隔离 cube；
#   以 `03-addons.sh quota` 的输出为准（公式只在那一处），每天重算 → 经验教训第 33 条。
# 没有建名为 `default` 的 LocalQueue：manageJobsWithoutQueueName: true 下，$NS 里不带队列名的 Job 会一直 suspended，
#   这正是闸门的意图（参考集群建了 default LQ，因此还得给 CPU-only 任务加 cpu-user flavor，见手册）。
# =============================================================================
apiVersion: kueue.x-k8s.io/v1beta2
kind: ClusterQueue
metadata:
  name: cluster-queue
spec:
  namespaceSelector: {}
  queueingStrategy: BestEffortFIFO
  admissionChecksStrategy:
    admissionChecks:
    - name: dynamic-slicing-ac
      onFlavors:
      - tpu7x-flavor-v2
  preemption:
    withinClusterQueue: LowerPriority
    reclaimWithinCohort: Never
    borrowWithinCohort:
      policy: Never
  resourceGroups:
  - coveredResources: ["google.com/tpu"]
    flavors:
    - name: tpu7x-flavor-v2
      resources:
      - name: google.com/tpu
        nominalQuota: "${TPU_QUOTA}"
---
apiVersion: kueue.x-k8s.io/v1beta2
kind: LocalQueue
metadata:
  namespace: ${NS}
  name: ${LOCAL_QUEUE}
spec:
  clusterQueue: cluster-queue
---
# hc：周期 / 准入健康检查专用队列（08a §8a.3 按 cube 测 C1/C2/C3），与生产共用 cluster-queue 的配额。
#   名字是本书示例（队列 `hc`）；字段与上面的生产 LocalQueue 一样，只换名字。
#   配合 03-kueue-priority.yaml 的 health-check 优先级（最低档）提交，生产任务可抢占它。
#   未实测：本书没有在集群上用过这个队列；验证 = apply 后 `kubectl -n $NS get localqueue hc` 有 CLUSTERQUEUE=cluster-queue，
#   再按 08a 提一个带 `kueue.x-k8s.io/queue-name: hc` + `kueue.x-k8s.io/priority-class: health-check` 的单 cube 作业看能否准入。
apiVersion: kueue.x-k8s.io/v1beta2
kind: LocalQueue
metadata:
  namespace: ${NS}
  name: hc
spec:
  clusterQueue: cluster-queue
