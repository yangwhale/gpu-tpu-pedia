# =============================================================================
# 06a-dsv3-recipe.env —— 06b（公开配置训练配方）的唯一参数源：镜像、MaxText 参数、libtpu flag
#
# 谁读它：06-jobset.sh（RECIPE=dsv3 时渲染 06a-jobset-dsv3.yaml）、06a-aot-dsv3.sh（CPU 上 AOT 编译）。
#   两边读同一份，保证「AOT 体检的配置」就是「真要跑的配置」——改这里，两边一起变。
#
# 出处：DeepSeek-V3 671B 单片基准 参考作业
#   （4x8x8 = 256 芯、30 步、合成数据）的 JobSet 原文
#   模型 yml 是上游公开的 AI-Hypercomputer/maxtext@54f66f5 src/maxtext/configs/models/deepseek3-671b-2dfsdp.yml。
#
# 和原文相比只改了这几处（其余逐字照抄）：
#   dcn_data_parallelism   -1 → 显式写片数（由 SLICES 渲染，默认 8；写死比 -1 好核对）
#   steps                  30 → 50（由 STEPS 渲染）
#   profiler               xplane → 关（profiler 会造出假象步，第一次验收不要它；要抓 trace 再加回）
#   run_name / base_output_directory / dataset_path   → 本书变量
#   LIBTPU_INIT_ARGS 末尾  + --megascale_grpc_interface_prefixes=eth1,eth2,lo（多片才用得到；JIT 基线作业在 10+ 片上验证过这组，
#                          见 06c §6.4.1；参考作业是单片，原文没有）
#   XLA_FLAGS（新增）      --xla_disable_hlo_passes=all_gather_decomposer,collective-pipeliner-forward
#                          **不加这一条，2 片及以上直接 OOM**：CPU AOT 实测，原样配置 1 片 temp 81.77 GiB，
#                          2 片 / 10+ 片都是 95.87 GiB > 94.74（编译报 RESOURCE_EXHAUSTED）；加上之后 10+ 片 78.82 GiB。
#                          同一现象实测集群在大号 MoE 模型上见过（06c §6.4.1「有 DCN DP 就必须带」），写法也照它（XLA_FLAGS 环境变量）。
# =============================================================================

# 镜像：公开的 MaxText nightly（tpu-prod-env-multipod 是 MaxText 官方镜像仓库），按 digest 钉死。
# tag = maxtext_54f66f5_20260924；digest 是本机 docker pull 的结果（jax/jaxlib 0.12.0.dev20260923、libtpu 0.0.49）。
# 节点拉不到时复制进使用方自己的 Artifact Registry，调用前 export RECIPE_IMAGE=<新地址@sha256:…> 覆盖（06b 前置条件「镜像可拉验证」；可覆盖这一点未实测）。
RECIPE_IMAGE="${RECIPE_IMAGE:-us-docker.pkg.dev/tpu-prod-env-multipod/maxtext-images/maxtext_jax_nightly@sha256:ee855b8087abe62722a3643f5f89a9ea52caa03ae12eb63f3c28643170c23cc5}"

# MaxText 模型 / 并行 / 显存 / kernel 参数（不含片数、步数、路径——那几个由调用方拼）
RECIPE_MODEL_ARGS="model_name=deepseek3-671b-2dfsdp per_device_batch_size=8 max_target_length=4096 \
dcn_pipeline_parallelism=1 ici_pipeline_parallelism=1 ici_fsdp_transpose_parallelism=2 ici_fsdp_parallelism=-1 \
allow_split_physical_axes=True use_iota_embed=True remat_policy=custom decoder_layer_input=offload \
opt_type=adamw mu_dtype=bfloat16 grad_dtype=bfloat16 megablox=True sparse_matmul=True use_custom_sort_vjp=True \
shard_exp_on_fsdp=False use_2d_fsdp_sharding=True \
sa_use_fused_bwd_kernel=True sa_block_q=2048 sa_block_kv=2048 sa_block_q_dkv=2048 sa_block_kv_dkv=2048 \
sa_block_kv_dkv_compute=2048 sa_block_kv_dq=2048 sa_block_q_dq=2048 attention=flash use_tokamax_splash=True \
use_max_logit_estimate=-1 cost_estimate_flops_fwd=5000000000000 cost_estimate_flops_bwd=5000000000000 \
float32_weight_sum=False use_tokamax_gmm=True use_gmm_v2=True \
wi_tile_fwd_batch_seq=256 wi_tile_fwd_embed_dim=7168 wi_tile_fwd_mlp_dim=1024 \
wi_tile_dlhs_batch_seq=256 wi_tile_dlhs_embed_dim=3584 wi_tile_dlhs_mlp_dim=2048 \
wi_tile_drhs_batch_seq=512 wi_tile_drhs_embed_dim=1792 wi_tile_drhs_mlp_dim=2048 \
wo_tile_fwd_batch_seq=512 wo_tile_fwd_embed_dim=3584 wo_tile_fwd_mlp_dim=2048 \
wo_tile_dlhs_batch_seq=512 wo_tile_dlhs_embed_dim=1792 wo_tile_dlhs_mlp_dim=2048 \
wo_tile_drhs_batch_seq=512 wo_tile_drhs_embed_dim=1792 wo_tile_drhs_mlp_dim=2048 \
tokenizer_path=assets/tokenizer.mistral-v3 dataset_type=synthetic enable_checkpointing=False"

# 编译器 flag（原文 32 个，逐字（用 yaml 解析逐个比对过）；p_state=3 是默认功耗档——开 7 要 Google 书面意见，06c §6.4.1）
RECIPE_XLA_FLAGS="--xla_tpu_dvfs_p_state=3 --xla_tpu_scoped_vmem_limit_kib=65536 --xla_tpu_bf16_emission_mode=NATIVE_EMISSION \
--xla_tpu_enable_sparse_core_reduce_scatter_v2=true --xla_tpu_enable_sparse_core_collective_offload_all_gather=true \
--xla_tpu_enable_sparse_core_collective_offload_2d_all_gather=true --xla_tpu_enable_all_gather_offload_tracing=true \
--xla_tpu_use_tc_device_shape_on_sc=True --xla_sc_disable_megacore_partitioning=True \
--xla_tpu_enable_async_collective_fusion_fuse_all_gather=false --xla_enable_async_all_gather=true \
--xla_tpu_prefer_async_allgather_to_allreduce=true --xla_tpu_enable_sparse_core_collective_offload_all_reduce=true \
--xla_tpu_enable_sparse_core_collective_offload_reduce_scatter=true --xla_tpu_enable_sparse_core_collective_offload_3d_all_gather=true \
--xla_tpu_use_single_sparse_core_for_all_gather_offload=true --xla_tpu_enable_concurrent_sparse_core_offloading=true \
--xla_tpu_aggressive_opt_barrier_removal=true --xla_tpu_enable_offloading_gather_to_sparsecore=true \
--xla_tpu_sparse_core_all_gather_latency_multiplier=1 --xla_tpu_sparse_core_reduce_scatter_latency_multiplier=3 \
--xla_tpu_enable_sparse_core_collective_aggregator=true --xla_tpu_enable_latency_hiding_layer_scheduler=false \
--xla_tpu_rerun_latency_hiding_scheduler_post_sc_assignment=true --xla_tpu_enable_offloading_copy_to_sparsecore=false \
--xla_tpu_scheduler_percent_shared_memory_limit=150 --xla_tpu_enable_layer_scheduler_for_dependent_collectives=true \
--xla_tpu_pcie_bandwidth_multiplier=0.03 --xla_tpu_enable_multi_compute_overlap_in_layer_scheduler=false \
--xla_tpu_enable_sparse_core_offload_queuing_in_lhs=true --xla_tpu_enable_sparse_core_collective_offload_nd_reduce_scatter=true \
--xla_tpu_enable_3d_reduce_scatter_decomposer=false"

# XLA_FLAGS 环境变量（不是 LIBTPU_INIT_ARGS）：关掉两个 HLO pass，防止多片时临时内存涨 14 GiB（见文件头）
RECIPE_XLA_FLAGS_ENV="--xla_disable_hlo_passes=all_gather_decomposer,collective-pipeliner-forward"

# 运行时（megascale = libtpu 的跨片 DCN 层）flag：只进 LIBTPU_INIT_ARGS，不进 AOT 的 compile_xla_flags（编译器不认）
RECIPE_RUNTIME_FLAGS="--megascale_grpc_interface_prefixes=eth1,eth2,lo"
